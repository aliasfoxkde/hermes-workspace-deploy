[Unit]
Description=Cloudflare Tunnel (hermes-workspace)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /home/debian/hermes-workspace/cloudflared.config.yml tunnel run
Restart=on-failure
RestartSec=5s
User=debian
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
