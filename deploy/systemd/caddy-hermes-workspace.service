[Unit]
Description=Caddy Reverse Proxy (hermes-workspace)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/caddy run --config /home/debian/hermes-workspace/deploy/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
User=debian
Group=debian
StandardOutput=journal
StandardError=journal
# Caddy needs CAP_NET_BIND_SERVICE to bind ports <1024, or run as root
# Running as root here since :8080/:8443 are non-privileged anyway
AmbientCapabilities=CAP_NET_BIND_SERVICE
EnvironmentFile=-/home/debian/hermes-workspace/.env

# Graceful shutdown timeout
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
